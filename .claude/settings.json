{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{spawnSync}=require('node:child_process');const{join}=require('node:path');const root=process.env.CLAUDE_PROJECT_DIR;if(!root)process.exit(2);const r=spawnSync(process.execPath,[join(root,'scripts','claude-hook-guard.mjs'),'protect-write'],{stdio:'inherit'});process.exit(r.status??2)\"",
            "timeout": 15,
            "statusMessage": "Verificando protecao de .env..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{spawnSync}=require('node:child_process');const{join}=require('node:path');const root=process.env.CLAUDE_PROJECT_DIR;if(!root)process.exit(2);const r=spawnSync(process.execPath,[join(root,'scripts','claude-hook-guard.mjs'),'protect-command'],{stdio:'inherit'});process.exit(r.status??2)\"",
            "timeout": 15,
            "statusMessage": "Verificando comando e acesso operacional..."
          }
        ]
      }
    ]
  }
}
