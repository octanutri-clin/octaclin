{
  "name": "octaclin-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build && node scripts/verificar-artefato-producao.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:abuso:redis-real": "jest --runInBand src/modulos/auth/aplicacao/servico-protecao-abuso.redis.integracao.spec.ts",
    "test:rls:testcontainers": "node scripts/test-rls-testcontainers.mjs",
    "typeorm": "typeorm-ts-node-commonjs -d src/infraestrutura/banco-dados/fonte-dados.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:generate": "npm run typeorm -- migration:generate src/infraestrutura/banco-dados/migracoes/MigracaoAutomatica",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed:demo": "ts-node src/infraestrutura/banco-dados/seeds/seed-demo.ts",
    "seed:staging": "ts-node src/infraestrutura/banco-dados/seeds/seed-staging.ts",
    "e2e:staging:prepare": "ts-node src/infraestrutura/e2e/preparar-ambiente-staging-e2e.ts",
    "e2e:staging:preflight": "ts-node src/infraestrutura/e2e/validar-ambiente-staging-e2e.ts",
    "e2e:fase235:prontuario": "ts-node src/infraestrutura/e2e/validar-prontuario-fase235.ts",
    "criar-admin:producao": "ts-node src/infraestrutura/banco-dados/seeds/criar-admin-producao.ts",
    "backfill:indices-busca": "ts-node src/infraestrutura/banco-dados/backfills/backfill-indices-busca-pacientes.ts",
    "smoke:operacoes": "ts-node src/infraestrutura/smoke/smoke-operacoes.ts",
    "smoke:busca-pacientes": "ts-node src/infraestrutura/smoke/smoke-busca-pacientes.ts",
    "performance:backend": "ts-node src/infraestrutura/performance/benchmark-backend.ts",
    "catalogo:taco:gerar": "ts-node scripts/importar-catalogo-taco.ts",
    "catalogo:taco:carregar": "ts-node scripts/carregar-catalogo-taco.ts",
    "gmail:oauth-token": "node scripts/gmail-oauth-token.mjs",
    "mock:api": "node scripts/api-demo-local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "bullmq": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.6",
    "otpauth": "^9.4.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.0",
    "testcontainers": "12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
