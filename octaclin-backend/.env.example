# OctaClin backend - exemplo local sem secrets reais.
# Copie para .env apenas no ambiente local. Nunca commite .env real.

NODE_ENV=development
PORT=3000
PORTA_HTTP=3000
CORS_ORIGINS=http://localhost:3000
OCTACLIN_WEB_URL=http://localhost:3000
EXPOR_LINK_RECUPERACAO_SENHA=true

# Banco: use DATABASE_URL para Neon/Render ou BANCO_* para Postgres local.
DATABASE_URL=
BANCO_HOST=localhost
BANCO_PORTA=5432
BANCO_USUARIO=octaclin
BANCO_SENHA=octaclin_local
BANCO_NOME=octaclin
BANCO_SSL=false
# O runtime nao executa DDL sem opt-in explicito. Use `true` apenas em ambiente
# controlado; em staging/producao, aplique com `pnpm migration:run` usando a role owner.
BANCO_EXECUTAR_MIGRACOES=false
BANCO_POOL_MAX=10
BANCO_POOL_CONNECTION_TIMEOUT_MS=5000
BANCO_POOL_IDLE_TIMEOUT_MS=30000
BANCO_HEALTH_TIMEOUT_MS=1500

# Redis: use REDIS_URL para Upstash/Render ou REDIS_* local.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORTA=6379
REDIS_USUARIO=
REDIS_SENHA=
REDIS_TLS=false

# Seguranca: gere valores fortes em staging/producao.
JWT_SEGREDO=troque_por_um_valor_longo_aleatorio
JWT_REFRESH_SEGREDO=troque_por_outro_valor_longo_aleatorio
JWT_EXPIRA_EM=15m
JWT_REFRESH_EXPIRA_EM=30d
CRIPTOGRAFIA_CHAVE_AES_256=base64_de_32_bytes_para_aes_256
FORMULARIO_PUBLICO_SEGREDO=troque_por_um_valor_aleatorio_de_32_bytes_ou_mais

# Meta WhatsApp: preencher apenas em ambiente privado.
META_WHATSAPP_TOKEN=placeholder_token_meta_cloud_api
META_WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque_este_token_de_verificacao
META_WHATSAPP_WEBHOOK_RECEIVE_TOKEN=troque_este_token_de_recebimento

# Email: SMTP Gmail funciona com senha de app; Gmail API exige OAuth.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_FAMILY=4
EMAIL_SMTP_ALLOW_INTERNAL_NETWORK_INTERFACES=true
EMAIL_SMTP_USUARIO=octaclinsys@gmail.com
EMAIL_SMTP_SENHA=senha_de_app_google
EMAIL_REMETENTE=OctaClin <octaclinsys@gmail.com>
EMAIL_PROVEDOR=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USUARIO=me
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

# Google Calendar: OAuth separado do Gmail se necessario.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo

# IA e armazenamento: manter sem chave publica.
IA_SERVICE_URL=http://localhost:8001
IA_SERVICE_TOKEN=trocar-por-segredo-aleatorio-com-32-ou-mais-caracteres
IA_SERVICE_TIMEOUT_MS=15000

ARMAZENAMENTO_BUCKET_MIDIA=octaclin-midias-local
ARMAZENAMENTO_S3_ENDPOINT=http://localhost:9000
ARMAZENAMENTO_S3_REGION=auto
ARMAZENAMENTO_S3_ACCESS_KEY_ID=chave_local
ARMAZENAMENTO_S3_SECRET_ACCESS_KEY=segredo_local
ARMAZENAMENTO_S3_IF_NONE_MATCH=true
ARMAZENAMENTO_S3_FORCE_PATH_STYLE=false
