{
  "name": "octaclin-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:next15": "node scripts/test-async-dynamic-apis.mjs",
    "test:base-visual": "node scripts/test-base-visual-navegacao.mjs",
    "test:authz": "node scripts/test-autorizacao-rotas.mjs && node scripts/test-agendamento-publico-bff.mjs && node scripts/test-questionarios-revisao-bff.mjs && node scripts/test-dashboard-clinico-bff.mjs",
    "test:agendamento-publico:bff": "node scripts/test-agendamento-publico-bff.mjs",
    "test:questionarios-revisao:bff": "node scripts/test-questionarios-revisao-bff.mjs",
    "test:importacao-pacientes": "node scripts/test-importacao-pacientes.mjs",
    "test:planos-alimentares:bff": "node scripts/test-planos-alimentares-bff.mjs",
    "test:exames-laboratoriais:bff": "node scripts/test-exames-laboratoriais-bff.mjs",
    "test:consentimentos-fotograficos:bff": "node scripts/test-consentimentos-fotograficos-bff.mjs",
    "test:condutas-terapeuticas:bff": "node scripts/test-condutas-terapeuticas-bff.mjs",
    "test:prontuario:validacao": "playwright test tests/visual/console-regression.spec.mjs --grep \"prontuario do paciente|Fase 239\" --reporter=list",
    "test:pwa": "node scripts/test-pwa-seguranca.mjs && playwright test tests/visual/pwa-portal.spec.mjs --reporter=list",
    "test:e2e:criticas": "playwright test tests/visual/jornadas-criticas.spec.mjs --reporter=list",
    "test:producao:readonly": "playwright test tests/visual/producao-readonly.spec.mjs --project=desktop-chromium --reporter=list",
    "test:a11y": "playwright test tests/visual/acessibilidade.spec.mjs --reporter=list",
    "test:questionarios-preview": "node scripts/test-questionarios-preview.mjs",
    "test:paleta": "playwright test tests/visual/paleta-comandos.spec.mjs --reporter=list",
    "smoke:visual": "playwright test",
    "smoke:ui": "node scripts/smoke-ui-regression.mjs",
    "smoke:e2e:bff": "node scripts/smoke-e2e-bff.mjs",
    "smoke:demo": "node scripts/smoke-e2e-bff.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.17": "3.3.17",
      "postcss@<=8.5.17": "8.5.23",
      "sharp@<0.35.0": "0.35.3"
    }
  }
}
