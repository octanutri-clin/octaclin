{
  "name": "octaclin-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:apis-dinamicas": "node scripts/test-async-dynamic-apis.mjs",
    "test:base-visual": "node scripts/test-base-visual-navegacao.mjs",
    "test:authz": "node scripts/test-autorizacao-rotas.mjs && node scripts/test-agendamento-publico-bff.mjs && node scripts/test-questionarios-revisao-bff.mjs && node scripts/test-dashboard-clinico-bff.mjs && node scripts/test-prontuario-timeline-bff.mjs && node scripts/test-planos-alimentares-bff.mjs && node scripts/test-nutricao-plano.mjs",
    "test:seguranca-operacional": "node scripts/test-seguranca-operacional.mjs",
    "test:seguranca-runtime": "node scripts/validar-seguranca-runtime.mjs",
    "test:agendamento-publico:bff": "node scripts/test-agendamento-publico-bff.mjs",
    "test:questionarios-revisao:bff": "node scripts/test-questionarios-revisao-bff.mjs",
    "test:importacao-pacientes": "node scripts/test-importacao-pacientes.mjs",
    "test:planos-alimentares:bff": "node scripts/test-planos-alimentares-bff.mjs",
    "test:nutricao-plano": "node scripts/test-nutricao-plano.mjs",
    "test:exames-laboratoriais:bff": "node scripts/test-exames-laboratoriais-bff.mjs",
    "test:consentimentos-fotograficos:bff": "node scripts/test-consentimentos-fotograficos-bff.mjs",
    "test:condutas-terapeuticas:bff": "node scripts/test-condutas-terapeuticas-bff.mjs",
    "test:prontuario:validacao": "playwright test tests/visual/console-regression.spec.mjs --grep \"prontuario do paciente|Fase 239\" --reporter=list",
    "test:fase248": "playwright test tests/visual/fase-248-estados-recuperacao.spec.mjs --project=desktop-chromium --reporter=list",
    "test:fase249": "playwright test tests/visual/fase-249-densidade-responsividade.spec.mjs --project=desktop-chromium --reporter=list",
    "test:fase251": "playwright test tests/visual/fase-251-linguagem-microcopy.spec.mjs --project=desktop-chromium --reporter=list",
    "test:linguagem": "node --test scripts/linguagem-interface-lib.spec.mjs && node scripts/test-linguagem-interface.mjs",
    "test:linguagem:fix": "node scripts/test-linguagem-interface.mjs --fix",
    "test:pwa": "node scripts/test-pwa-seguranca.mjs && playwright test tests/visual/pwa-portal.spec.mjs --reporter=list",
    "test:e2e:criticas": "playwright test tests/visual/jornadas-criticas.spec.mjs --reporter=list",
    "test:producao:readonly": "playwright test tests/visual/producao-readonly.spec.mjs --project=desktop-chromium --reporter=list",
    "test:a11y": "playwright test tests/visual/acessibilidade.spec.mjs --reporter=list",
    "test:fase252": "playwright test tests/visual/fase-252-navegacao-descoberta.spec.mjs --project=desktop-chromium --reporter=list",
    "test:questionarios-preview": "node scripts/test-questionarios-preview.mjs",
    "test:paleta": "playwright test tests/visual/paleta-comandos.spec.mjs --reporter=list",
    "smoke:visual": "playwright test",
    "smoke:ui": "node scripts/smoke-ui-regression.mjs",
    "smoke:e2e:bff": "node scripts/smoke-e2e-bff.mjs",
    "e2e:staging:mutavel": "node scripts/e2e-staging-mutavel.mjs",
    "e2e:fase228:onboarding": "node scripts/e2e-fase-228-onboarding.mjs",
    "smoke:demo": "node scripts/smoke-e2e-bff.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "fast-uri@3": "3.1.5",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.17": "8.5.23",
      "sharp@<0.35.0": "0.35.3"
    }
  }
}
