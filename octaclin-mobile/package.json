    "audit:security": "node scripts/audit-seguranca.mjs",
    "audit:a11y": "node scripts/auditoria-acessibilidade.mjs",
    "test:security": "node --test scripts/audit-seguranca.spec.mjs",
    "test:a11y": "node --test scripts/auditoria-acessibilidade.spec.mjs",
    "build:validate": "expo export --platform all --output-dir .expo/export-smoke"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "expo": "^57.0.19",
    "expo-audio": "~57.0.4",
    "expo-camera": "^57.0.4",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "^57.0.18",
    "expo-sqlite": "^57.0.2",
    "expo-status-bar": "^57.0.1",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "react-native": "^0.86.2",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
